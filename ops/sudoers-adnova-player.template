# The player's limited sudo rule — the single source of truth for it.
#
# Installed by ops/provision.sh at setup and re-installed by ops/adnova-update.sh
# on any release that touches ops/, with @APP_USER@ replaced by the service
# account from adnova-player.service. It lived as a literal string in both of
# those scripts once; they drifted, `systemctl poweroff` was added to the player
# and to only one of the copies, and Dashboard's shutdown button failed with a
# bare sudo error for every release in between. One file, two consumers.
#
# Every invocation is spelled out in full with no wildcard. The worst this hands
# a compromised player is the ability to restart, reboot or power off the one
# device it already runs on.
@APP_USER@ ALL=(root) NOPASSWD: /usr/bin/systemctl restart adnova-player, /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /usr/bin/systemctl start adnova-update.service, /usr/bin/systemctl start --no-block adnova-os-update.service
