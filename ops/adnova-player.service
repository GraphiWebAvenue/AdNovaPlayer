[Unit]
Description=AdNova Player — plays this stand's schedule
Documentation=https://github.com/GraphiWebAvenue/AdNovaPlayer
After=network-online.target
Wants=network-online.target

# Never give up restarting. systemd's default start-rate limit would stop
# trying after five failures in ten seconds and leave the stand dead until
# somebody visited it — the opposite of what an unattended device needs.
#
# This lived in [Service] until v1.8.0, where systemd ignores it: the key
# belongs to [Unit], and every start logged
# "Unknown key 'StartLimitIntervalSec' in section [Service], ignoring."
# So the protection that was written down was never actually in force.
StartLimitIntervalSec=0

[Service]
# notify, not exec: the player sends READY=1 once its loops are running,
# so systemd knows the difference between "process started" and "actually
# playing", and the watchdog protocol below is active.
Type=notify
User=adnova
Group=adnova

# The stand id, key and trusted signing keys. Root-owned, mode 0600 — a
# leaked key exposes exactly this one screen and nothing else.
EnvironmentFile=/etc/adnova-player/env

# The kiosk browser needs a session bus and a display. Wayland on the
# Pi's default (labwc) exposes both here; the launcher script starts the
# compositor and Chromium, this service is the brain behind them.
Environment=PYTHONUNBUFFERED=1

WorkingDirectory=/opt/adnova-player/current
ExecStart=/opt/adnova-player/venv/bin/python -m adnova_player.main

# The heart of "never a dark screen for long": if the process dies for any
# reason, systemd brings it straight back, backing off only enough to
# avoid a tight crash-spin.
Restart=always
RestartSec=3

# ── systemd software watchdog ───────────────────────────────────────────
#
# The player pings systemd on a timer (sd_notify WATCHDOG=1). If it stops
# pinging — a deadlock, a wedged thread — systemd kills and restarts it
# even though the process is technically still alive. This catches the
# hangs that Restart=always alone cannot.
#
# The hardware watchdog (/dev/watchdog, enabled in the installer) sits
# under this: if systemd ITSELF wedges, the Pi's silicon reboots the whole
# board. Two nets, one under the other.
WatchdogSec=60
NotifyAccess=main

# ── Resource bounds ─────────────────────────────────────────────────────
#
# The brain is light; the browser is the heavy part and runs in its own
# session. This keeps a runaway in the Python side from taking the board
# down.
MemoryMax=256M
TasksMax=64

# ── Hardening ───────────────────────────────────────────────────────────
#
# NoNewPrivileges is deliberately NOT set, and that needs explaining because
# it looks like an omission.
#
# `sudo` is setuid. NoNewPrivileges=true forbids exactly that escalation, so
# with it set every one of the five invocations in
# ops/sudoers-adnova-player.template is impossible — the player asks, and sudo
# answers:
#
#     sudo: The "no new privileges" flag is set, which prevents sudo from
#     running as root.
#
# Which meant restart, reboot, shutdown, update and os_update — every command
# that touches the system — could never work, on any device, in any release.
# The buttons queued, the device received them, and each one failed at the
# first syscall. Two pieces of hardening written against each other, and the
# sudoers allow-list is the one that was designed: a closed list of five exact
# systemctl invocations, no wildcard, reasoned about in its own file.
#
# So the escalation boundary is that allow-list, not this flag. The worst it
# hands a compromised player is the ability to restart, reboot or power off
# the one device it already runs on — which is the trade the sudoers rule
# states outright.
#
# Everything else below stays. RestrictSUIDSGID keeps the process from
# *creating* setuid files, which is the part that actually matters for a
# process that parses untrusted media; it does not block running sudo.
#
# The stricter alternative — keep NoNewPrivileges and have a root-side path
# unit watch a request file, the way the kiosk helper already works — is the
# better long-term shape and is worth doing deliberately rather than as a
# hotfix.
ProtectSystem=strict
# The one place it may write: the media cache and logs.
ReadWritePaths=/var/lib/adnova-player
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
