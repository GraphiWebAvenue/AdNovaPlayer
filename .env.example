# Provisioned onto each Pi at install time.

# Which stand this device is. Printed on the install sheet.
ADNOVA_STAND_ID=

# This stand's API key. Root-owned, mode 0600 — a leaked key exposes
# exactly this one screen and nothing else.
ADNOVA_STAND_KEY=

ADNOVA_BASE_URL=https://dashboard.adnovatech.online

# Where the schedule and downloaded media live.
ADNOVA_CACHE_DIR=/var/lib/adnova-player

# Overridden by whatever the manifest's `poll` block says, so the fleet
# is retuned from Dashboard rather than by editing files on every device.
ADNOVA_MANIFEST_POLL_SECONDS=600
ADNOVA_HEARTBEAT_SECONDS=60
